{
  "name": "read-then-list",
  "files": { "notes.txt": "hello from the qa runner\n" },
  "turns": [
    {
      "prompt": "Read notes.txt and tell me what it says in one line.",
      "minTools": 1,
      "toolOutputContains": "hello from the qa runner"
    },
    {
      "prompt": "Now run ls and tell me how many files there are.",
      "minTools": 1,
      "toolOutputContains": "notes.txt"
    }
  ],
  "hooksPerTurn": { "claude": ["UserPromptSubmit", "Stop"], "codex": ["UserPromptSubmit", "Stop"] }
}
