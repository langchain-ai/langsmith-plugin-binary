{
  "executableName": "langsmith-claude-code-tracing",
  "repository": "langchain-ai/langsmith-claude-code-plugins",
  "build": {
    "entryPoint": "src/hooks/dispatch.ts",
    "outputDirectory": "bin",
    "versionFile": "package.json",
    "matchingVersionFiles": [".claude-plugin/plugin.json"],
    "stampedVersionFiles": ["bundle/dispatch.js"],
    "minify": false,
    "defines": {
      "__LS_BINARY_HOOKS__": "hooks/hooks.binary.json"
    }
  },
  "sign": {
    "entitlements": "macos-entitlements.plist"
  }
}
